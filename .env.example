# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=

# System Configuration
SYSTEM_PROMPT=You are a helpful AI assistant with access to various tools and workflows.

# Interface Mode: "cli" or "telegram"
INTERFACE_MODE=cli

# Telegram Bot Configuration (only needed if INTERFACE_MODE=telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram user IDs allowed to use the bot
# Leave empty to allow all users (not recommended for production)
TELEGRAM_ALLOWED_USERS=

# Plugin Configuration
PLUGINS_DIR=./plugins

# Logging
LOG_LEVEL=info

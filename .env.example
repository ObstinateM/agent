# =============================================================================
# Core Configuration
# =============================================================================

# OpenAI Configuration (required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=

# System Configuration
SYSTEM_PROMPT=You are a helpful AI assistant with access to various tools and workflows.
PLUGINS_DIR=./plugins
LOG_LEVEL=info

# Interface Mode: comma-separated list of interfaces to enable
# Available: cli, telegram
# Examples:
#   INTERFACE_MODE=cli                  # CLI only (default)
#   INTERFACE_MODE=telegram             # Telegram only
#   INTERFACE_MODE=cli,telegram         # Both CLI and Telegram simultaneously
INTERFACE_MODE=cli

# =============================================================================
# Plugin: Telegram (only needed if INTERFACE_MODE=telegram)
# =============================================================================

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram user IDs allowed to use the bot
# Leave empty to allow all users (not recommended for production)
# Get your user ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=

# =============================================================================
# Plugin: IDFM (Île-de-France Mobilités)
# =============================================================================

# PRIM API key from https://prim.iledefrance-mobilites.fr/
IDFM_PRIM_API_KEY=your_idfm_prim_api_key_here

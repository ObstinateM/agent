# =============================================================================
# Core Configuration
# =============================================================================

# OpenAI Configuration (required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=

# System Configuration
SYSTEM_PROMPT=You are a helpful AI assistant with access to various tools and workflows.
PLUGINS_DIR=./plugins
LOG_LEVEL=info

# Interface Mode: comma-separated list of interfaces to enable
# Available: cli, telegram
# Examples:
#   INTERFACE_MODE=cli                  # CLI only (default)
#   INTERFACE_MODE=telegram             # Telegram only
#   INTERFACE_MODE=cli,telegram         # Both CLI and Telegram simultaneously
INTERFACE_MODE=cli

# =============================================================================
# Plugin: Telegram (only needed if INTERFACE_MODE=telegram)
# =============================================================================

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram user IDs allowed to use the bot
# Leave empty to allow all users (not recommended for production)
# Get your user ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=

# =============================================================================
# Plugin: IDFM (Île-de-France Mobilités)
# =============================================================================

# PRIM API key from https://prim.iledefrance-mobilites.fr/
IDFM_PRIM_API_KEY=your_idfm_prim_api_key_here

# =============================================================================
# Plugin: Sonarr (TV Series Management)
# =============================================================================

# Sonarr URL (including port if needed)
SONARR_URL=http://localhost:8989

# Sonarr API Key (found in Settings > General > Security)
SONARR_API_KEY=your_sonarr_api_key_here

# Optional: Basic auth credentials if Sonarr is behind nginx basic auth
# SONARR_BASIC_AUTH_USER=
# SONARR_BASIC_AUTH_PASS=

# =============================================================================
# Plugin: Radarr (Movie Management)
# =============================================================================

# Radarr URL (including port if needed)
RADARR_URL=http://localhost:7878

# Radarr API Key (found in Settings > General > Security)
RADARR_API_KEY=your_radarr_api_key_here

# Optional: Basic auth credentials if Radarr is behind nginx basic auth
# RADARR_BASIC_AUTH_USER=
# RADARR_BASIC_AUTH_PASS=

# =============================================================================
# Plugin: Home Assistant
# =============================================================================

# Home Assistant URL (including port if needed)
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Long-lived access token from Home Assistant
# Generate at: Profile > Long-Lived Access Tokens > Create Token
HOME_ASSISTANT_TOKEN=your_home_assistant_token_here
